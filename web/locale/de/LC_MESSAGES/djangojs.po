msgstr "nur du :: schicke die Adresse dieser Seite an andere"

#: static/js/assembly/presence.js:262
msgid "%(count)s here"
msgstr "%(count)s hier"

#: static/js/assembly/presence.js:264
msgid ""
"offline :: you can add reasons, but other people do not see your typing"
msgstr ""
"offline :: du kannst Gründe hinzufügen, aber andere sehen nicht, was du "
"schreibst"

#: static/js/assembly/presence.js:270
msgid "enable sound"
msgstr "Ton aktivieren"

#: static/js/assembly/presence.js:340
msgid "%(name)s (you)"
msgstr "%(name)s (du)"

#: static/js/assembly/presence.js:342 static/js/assembly/presence.js.c:353
