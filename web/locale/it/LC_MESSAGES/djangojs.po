msgid "cite in notes"
msgstr "cita nelle note"

msgid "add to this session"
msgstr "aggiungi a questa sessione"

msgid "download"
msgstr "scarica"

msgid "remove"
msgstr "rimuovi"

msgid "Remove this document from the space?"
msgstr "Rimuovere questo documento dallo spazio?"

