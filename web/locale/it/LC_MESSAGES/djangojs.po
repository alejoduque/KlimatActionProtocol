msgstr "muto"

#: static/js/assembly/presence.js:432
msgid ""
"The browser cannot use the device. Give permission in the browser settings."
msgstr ""
"Il browser non può usare il dispositivo. Dai il permesso nelle impostazioni "
"del browser."

#: static/js/assembly/presence.js:433
msgid "No device (%(error)s). Camera and microphone need https or localhost."
msgstr ""
"Nessun dispositivo (%(error)s). Videocamera e microfono richiedono https o "
"localhost."

msgid "loading…"
msgstr "caricamento…"

msgid "saved"
msgstr "salvato"

msgid "the notes did not load"
msgstr "le note non si sono caricate"

msgid "not saved yet"
msgstr "non ancora salvato"

msgid "another person saves these notes"
msgstr "un'altra persona salva queste note"

msgid "not saved :: trying again"
msgstr "non salvato :: nuovo tentativo"

msgid "taking notes"
msgstr "prende appunti"

msgid "That did not work. Try again."
msgstr "Non ha funzionato. Riprova."

msgid "%(name)s shows a document to everyone"
msgstr "%(name)s mostra un documento a tutte le persone"

msgid "End this session for everyone?"
msgstr "Terminare questa sessione per tutte le persone?"

msgid "The link is copied. Whoever has it can enter this space."
msgstr "Il link è copiato. Chi lo ha può entrare in questo spazio."

msgid "The link of this space:"
msgstr "Il link di questo spazio:"

msgid ""
"Make a new link? The old link stops working, and everyone needs the new one."
" An anarlog connection is not affected."
msgstr ""
"Creare un nuovo link? Quello vecchio smette di funzionare e tutte le persone"
" hanno bisogno del nuovo. Una connessione con anarlog non cambia."

msgid "start a session to take notes"
msgstr "inizia una sessione per prendere note"

msgid "no sessions yet"
msgstr "ancora nessuna sessione"

msgid "now"
msgstr "ora"

msgid "all categories"
msgstr "tutte le categorie"

msgid "%(used)s of %(max)s"
msgstr "%(used)s di %(max)s"

msgid "connected"
msgstr "collegato"

msgid "not connected"
msgstr "non collegato"

msgid "I stopped taking notes"
msgstr "Ho smesso di prendere appunti"

msgid "I'm taking notes"
msgstr "Sto prendendo appunti"

msgid "suggested category"
msgstr "categoria suggerita"

msgid "+ category"
msgstr "+ categoria"

msgid "category"
msgstr "categoria"

msgid "pasted image"
msgstr "immagine incollata"

msgid "too big :: the limit is %(max)s"
msgstr "troppo grande :: il limite è %(max)s"

msgid "close"
msgstr "chiudi"

