msgstr "KLAP non mostra questo tipo di file. Scaricalo per leggerlo."

msgid "edit"
msgstr "modifica"

msgid "title"
msgstr "titolo"

msgid "text"
msgstr "testo"

msgid "history (%(count)s)"
msgstr "storia (%(count)s)"

msgid "Bring this version back? It becomes a new edit for everyone."
msgstr ""
"Ripristinare questa versione? Diventa una nuova modifica per tutte le "
"persone."

msgid "no saved versions yet"
msgstr "ancora nessuna versione salvata"

msgid "you"
msgstr "tu"

msgid "recording notes on their computer :: %(names)s"
msgstr "registra appunti sul proprio computer :: %(names)s"

msgid "The summary is in this session."
msgstr "Il riassunto è in questa sessione."

msgid "Anarlog is connected. Click Test in anarlog to check."
msgstr "Anarlog è collegato. Clicca Test in anarlog per verificare."
