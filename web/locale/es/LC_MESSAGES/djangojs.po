msgstr "Todas las personas en este espacio ven ahora este documento."

msgid "cite in notes"
msgstr "citar en las notas"

msgid "add to this session"
msgstr "añadir a esta sesión"

msgid "download"
msgstr "descargar"

msgid "remove"
msgstr "quitar"

msgid "Remove this document from the space?"
msgstr "¿Quitar este documento del espacio?"

msgid "KLAP does not show this type of file. Download it to read it."
msgstr "KLAP no muestra este tipo de archivo. Descárgalo para leerlo."

msgid "edit"
msgstr "editar"

msgid "title"
msgstr "título"

msgid "text"
msgstr "texto"

msgid "history (%(count)s)"
msgstr "historia (%(count)s)"

msgid "Bring this version back? It becomes a new edit for everyone."
msgstr "¿Recuperar esta versión? Será una edición nueva para todas las personas."

msgid "no saved versions yet"
msgstr "todavía no hay versiones guardadas"

msgid "you"
msgstr "tú"

msgid "recording notes on their computer :: %(names)s"
msgstr "grabando notas en su computador :: %(names)s"

msgid "The summary is in this session."
msgstr "El resumen está en esta sesión."

msgid "Anarlog is connected. Click Test in anarlog to check."
msgstr "Anarlog está conectado. Pulsa Test en anarlog para comprobarlo."
