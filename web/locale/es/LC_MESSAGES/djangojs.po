msgid "enable sound"
msgstr "activar el sonido"

#: static/js/assembly/presence.js:340
msgid "%(name)s (you)"
msgstr "%(name)s (tú)"

#: static/js/assembly/presence.js:342 static/js/assembly/presence.js.c:353
msgid "mic on"
msgstr "micrófono encendido"

#: static/js/assembly/presence.js:342
msgid "muted"
msgstr "sin sonido"

#: static/js/assembly/presence.js:432
msgid ""
"The browser cannot use the device. Give permission in the browser settings."
msgstr ""
"El navegador no puede usar el dispositivo. Dale permiso en los ajustes del "
"navegador."

#: static/js/assembly/presence.js:433
msgid "No device (%(error)s). Camera and microphone need https or localhost."
msgstr ""
"No hay dispositivo (%(error)s). La cámara y el micrófono necesitan https o "
"localhost."
