#: static/js/assembly/live.js:457
msgid "%(count)s reason is about this word"
msgid_plural "%(count)s reasons are about this word"
msgstr[0] "%(count)s razón es sobre esta palabra"
msgstr[1] "%(count)s razones son sobre esta palabra"

#: static/js/assembly/live.js:462
msgid "ask what this word means"
msgstr "pregunta qué significa esta palabra"

#: static/js/assembly/live.js:597
msgid "answer with :: everyone here sees you type"
msgstr "responde con :: todas las personas aquí ven lo que escribes"

#: static/js/assembly/live.js:598
msgid ""
"choose how your reason answers the claim :: everyone here sees you type"
